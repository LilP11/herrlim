---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Menu from '../components/Menu.astro';
import Location from '../components/Location.astro';
import Order from '../components/Order.astro';
import Footer from '../components/Footer.astro';

const lang = 'de';
---

<Layout
  lang={lang}
  title="Herr Lim – Koreanisches Street Food in Bad Homburg"
  description="Authentisches koreanisches Street Food in Bad Homburg vor der Höhe. Cupbap, Ramen, Tteokbokki, K-Hotdogs und mehr. Montag bis Freitag geöffnet."
>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <Menu lang={lang} />
    <Location lang={lang} />
    <Order lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
