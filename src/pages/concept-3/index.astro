---
import Layout from '../../layouts/Layout.astro';
import ConceptSwitcher from '../../components/ConceptSwitcher.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Menu from '../../components/Menu.astro';
import Location from '../../components/Location.astro';
import Order from '../../components/Order.astro';
import Footer from '../../components/Footer.astro';
---

<Layout lang="de" title="Herr Lim – Konzept 3: Gemütlich">
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800&display=swap"
    rel="stylesheet"
  />
  <ConceptSwitcher current={3} />
  <Nav lang="de" />
  <main>
    <Hero lang="de" />
    <About lang="de" />
    <Menu lang="de" />
    <Location lang="de" />
    <Order lang="de" />
  </main>
  <Footer lang="de" />
</Layout>

<style is:global>
  /* ── Gemütlich theme: warm beige · light brown · cozy ── */
  :root {
    --bg:           #FBF8F3;
    --bg-alt:       #F2EAE0;
    --bg-dark:      #2E2A26;
    --bg-dark-alt:  #231F1C;
    --text:         #2E2A26;
    --text-muted:   #8A7D70;
    --accent:       #B8885A;
    --accent-hover: #A07A50;
    --accent-light: rgba(184, 136, 90, 0.11);
    --border:       #E4D8CC;
    --font-display: 'Nunito', system-ui, sans-serif;
    --font-sans:    'Nunito', system-ui, sans-serif;
  }

  /* Push nav below concept bar */
  .nav { top: 42px; }

  /* ── Nav ── */
  .nav-logo   { color: var(--accent); }
  .nav-cta    { border-radius: 50px !important; }
  .lang-switch { border-radius: 50px !important; }

  /* ── Hero: warmer dark overlay ── */
  .hero {
    background:
      linear-gradient(
        rgba(46, 42, 38, 0.84) 0%,
        rgba(46, 42, 38, 0.77) 40%,
        rgba(46, 42, 38, 0.91) 100%
      ),
      url('https://images.unsplash.com/photo-1775883376447-655984a514bd?auto=format&fit=crop&w=1920&q=80')
      center / cover no-repeat;
  }

  .hero-title {
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .hero-eyebrow { color: #D4A87A; }

  .btn-primary { border-radius: 50px; }
  .btn-outline { border-radius: 50px; }

  /* ── About ── */
  .about { padding-top: 6.5rem; padding-bottom: 6.5rem; }

  .about-heading {
    font-weight: 800;
    font-style: normal;
  }

  .about-heading em {
    font-style: italic;
    font-weight: 800;
    color: var(--accent);
  }

  .stat-value { color: var(--accent); }

  .about-photo-wrap {
    border-radius: 18px;
    border-color: var(--border);
  }

  .about-photo { border-radius: 17px; }

  .review-card {
    border-radius: 18px;
    background: #FBF8F3;
    border-color: var(--border);
  }

  .review-quote {
    font-size: 3.5rem;
    color: var(--accent);
    opacity: 0.35;
  }

  /* ── Menu ── */
  .menu { padding-top: 6.5rem; padding-bottom: 6.5rem; }

  .cat-header {
    border-bottom: 2px dotted var(--border);
  }

  .highlight-card {
    border-radius: 18px;
    border-color: transparent;
    box-shadow: 0 4px 20px rgba(46, 42, 38, 0.08);
  }

  .item-card {
    border-radius: 14px;
    border-color: transparent;
    box-shadow: 0 2px 8px rgba(46, 42, 38, 0.06);
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .item-card:hover {
    border-color: transparent;
    box-shadow: 0 8px 28px rgba(46, 42, 38, 0.11);
    transform: translateY(-3px);
  }

  .item-price { color: var(--accent); }

  .tag-veg {
    background: rgba(118, 172, 112, 0.13);
    color: #3A7036;
    border-radius: 50px;
  }

  .tag-spicy {
    background: rgba(194, 120, 60, 0.12);
    color: #9A5520;
    border-radius: 50px;
  }

  .tag-hot {
    background: rgba(184, 136, 90, 0.14);
    color: #7A5230;
    border-radius: 50px;
  }

  /* ── Order CTA ── */
  .order { background: var(--accent); }

  .order-btn-primary {
    border-radius: 50px;
    background: white;
    color: var(--accent);
  }

  .order-btn-outline {
    border-radius: 50px;
    border-color: rgba(255,255,255,0.45);
  }

  /* ── Footer ── */
  .footer-logo { color: #D4A87A; }

  /* ── Mobile ── */
  @media (max-width: 720px) {
    .about, .menu { padding-top: 4rem; padding-bottom: 4rem; }
  }
</style>
