---
import Layout from '../../layouts/Layout.astro';
import ConceptSwitcher from '../../components/ConceptSwitcher.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Menu from '../../components/Menu.astro';
import Location from '../../components/Location.astro';
import Order from '../../components/Order.astro';
import Footer from '../../components/Footer.astro';
---

<Layout lang="de" title="Herr Lim – Konzept 1: Seoul Night">
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <ConceptSwitcher current={1} />
  <Nav lang="de" />
  <main>
    <Hero lang="de" />
    <About lang="de" />
    <Menu lang="de" />
    <Location lang="de" />
    <Order lang="de" />
  </main>
  <Footer lang="de" />
</Layout>

<style is:global>
  /* ── Seoul Night theme ── */
  :root {
    --bg:           #0E0B0A;
    --bg-alt:       #181310;
    --bg-dark:      #080605;
    --bg-dark-alt:  #040302;
    --text:         #F0EBE3;
    --text-muted:   #887F77;
    --accent:       #E63329;
    --accent-hover: #CC2B22;
    --accent-light: rgba(230, 51, 41, 0.15);
    --border:       rgba(240, 235, 227, 0.08);
    --font-display: 'Barlow Condensed', sans-serif;
    --font-sans:    'Inter', system-ui, sans-serif;
  }

  /* Push content below both sticky bars */
  .nav { top: 42px; }

  /* Condensed uppercase headings */
  .hero-title {
    letter-spacing: 0.02em;
    font-weight: 800;
  }

  .about-heading,
  .menu-title,
  .location-title,
  .order-title {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-style: normal;
  }

  .about-heading em {
    font-style: normal;
    color: var(--accent);
  }

  /* Amber accent on prices — feels like a price board */
  .item-price { color: #F5A623; }

  /* Glow on hover for dark cards */
  .item-card:hover {
    border-color: rgba(230, 51, 41, 0.35);
    box-shadow: 0 0 20px rgba(230, 51, 41, 0.08);
  }

  /* Highlight labels pick up amber */
  .highlight-card:hover .hl-name { color: #F5A623; }

  /* Footer logo colour */
  .footer-logo { color: #F5A623; }

  /* Nav logo */
  .nav-logo { color: #F5A623; }

  /* About photo border on dark */
  .about-photo-wrap { border-color: rgba(240,235,227,0.1); }

  /* Review cards on dark */
  .review-card { border-color: rgba(240,235,227,0.07); }

  /* Stat values in amber */
  .stat-value { color: #F5A623; }
</style>
