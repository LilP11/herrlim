---
interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
}

const {
  title = 'Herr Lim – Koreanisches Street Food in Bad Homburg',
  description = 'Authentisches koreanisches Street Food in Bad Homburg vor der Höhe. Cupbap, Ramen, Tteokbokki, K-Hotdogs und mehr. Montag bis Freitag geöffnet.',
  lang = 'de',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // ── Bidirectional scroll observer ──
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('in-view');
            e.target.classList.remove('above');
          } else {
            e.target.classList.remove('in-view');
            // Track position so re-entry knows which direction to animate from
            const r = e.target.getBoundingClientRect();
            if (r.bottom < window.innerHeight * 0.5) {
              e.target.classList.add('above');
            } else {
              e.target.classList.remove('above');
            }
          }
        });
      }, { threshold: 0.12, rootMargin: '-8px 0px -8px 0px' });

      document.querySelectorAll('[data-animate]').forEach(el => io.observe(el));

      // ── 3D card tilt on hover (desktop only) ──
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll('[data-tilt]').forEach(card => {
          card.addEventListener('mousemove', e => {
            if (!card.classList.contains('in-view')) return;
            const r  = card.getBoundingClientRect();
            const x  = ((e.clientX - r.left) / r.width  - 0.5) * 2;
            const y  = ((e.clientY - r.top)  / r.height - 0.5) * 2;
            card.style.transform  = `perspective(700px) rotateY(${x * 9}deg) rotateX(${-y * 9}deg) translateZ(10px) scale(1.02)`;
            card.style.transition = 'none';
            card.style.zIndex     = '2';
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform  = '';
            card.style.transition = 'transform 0.55s cubic-bezier(0.23, 1, 0.32, 1)';
            card.style.zIndex     = '';
          });
        });
      }

      // ── Cube parallax (starts after enter animation finishes) ──
      const cubeWrap = document.querySelector('.cube-wrap');
      if (cubeWrap) {
        setTimeout(() => {
          window.addEventListener('scroll', () => {
            cubeWrap.style.transform =
              `translateY(calc(-50% + ${window.scrollY * 0.18}px))`;
          }, { passive: true });
        }, 2100);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf7f2;
    --bg-alt: #f2ede5;
    --bg-dark: #1c1917;
    --bg-dark-alt: #2c2420;
    --text: #1c1917;
    --text-muted: #78716c;
    --accent: #c0392b;
    --accent-hover: #a93225;
    --accent-light: rgba(192, 57, 43, 0.09);
    --border: #e7e0d8;
    --font-display: 'DM Serif Display', Georgia, serif;
    --font-sans: 'DM Sans', system-ui, sans-serif;
    --max-w: 1100px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .section-label {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
    display: block;
  }

  /* ── Scroll animations — bidirectional + 3D ── */
  [data-animate] {
    opacity: 0;
    transition:
      opacity  0.72s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  /* Below viewport (default entry — slides up with 3D tilt) */
  [data-animate='slide-up']    { transform: perspective(900px) translateY(52px)  rotateX(12deg); }
  [data-animate='slide-left']  { transform: perspective(900px) translateX(56px)  rotateY(-12deg); }
  [data-animate='slide-right'] { transform: perspective(900px) translateX(-56px) rotateY(12deg); }
  [data-animate='scale-in']    { transform: perspective(900px) scale(0.82)       rotateX(10deg); }
  [data-animate='flip-up']     { transform: perspective(700px) rotateX(60deg) translateY(24px); transform-origin: bottom center; }

  /* Above viewport (re-entry from scrolling back up) */
  [data-animate='slide-up'].above    { transform: perspective(900px) translateY(-32px) rotateX(-8deg); }
  [data-animate='slide-left'].above  { transform: perspective(900px) translateY(-28px) rotateY(-4deg); }
  [data-animate='slide-right'].above { transform: perspective(900px) translateY(-28px) rotateY(4deg); }
  [data-animate='scale-in'].above    { transform: perspective(900px) scale(0.94) rotateX(-6deg); }
  [data-animate='flip-up'].above     { transform: perspective(700px) rotateX(-25deg) translateY(-16px); transform-origin: top center; }

  /* Visible */
  [data-animate].in-view {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate],
    [data-animate].above,
    [data-animate].in-view {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
