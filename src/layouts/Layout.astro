---
interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
}

const {
  title = 'Herr Lim – Koreanisches Street Food in Bad Homburg',
  description = 'Authentisches koreanisches Street Food in Bad Homburg vor der Höhe. Cupbap, Ramen, Tteokbokki, K-Hotdogs und mehr. Montag bis Freitag geöffnet.',
  lang = 'de',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // ── Bidirectional scroll observer ──
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('in-view');
            e.target.classList.remove('above');
          } else {
            e.target.classList.remove('in-view');
            // Track position so re-entry knows which direction to animate from
            const r = e.target.getBoundingClientRect();
            if (r.bottom < window.innerHeight * 0.5) {
              e.target.classList.add('above');
            } else {
              e.target.classList.remove('above');
            }
          }
        });
      }, { threshold: 0.12, rootMargin: '-8px 0px -8px 0px' });

      document.querySelectorAll('[data-animate]').forEach(el => io.observe(el));

      // ── 3D card tilt on hover (desktop only) ──
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll('[data-tilt]').forEach(card => {
          card.addEventListener('mousemove', e => {
            if (!card.classList.contains('in-view')) return;
            const r  = card.getBoundingClientRect();
            const x  = ((e.clientX - r.left) / r.width  - 0.5) * 2;
            const y  = ((e.clientY - r.top)  / r.height - 0.5) * 2;
            card.style.transform  = `perspective(700px) rotateY(${x * 9}deg) rotateX(${-y * 9}deg) translateZ(10px) scale(1.02)`;
            card.style.transition = 'none';
            card.style.zIndex     = '2';
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform  = '';
            card.style.transition = 'transform 0.55s cubic-bezier(0.23, 1, 0.32, 1)';
            card.style.zIndex     = '';
          });
        });
      }

      // (scroll handled inside RamenBowl component)
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg:           #FBF8F3;
    --bg-alt:       #F2EAE0;
    --bg-dark:      #2E2A26;
    --bg-dark-alt:  #231F1C;
    --text:         #2E2A26;
    --text-muted:   #8A7D70;
    --accent:       #B8885A;
    --accent-hover: #A07A50;
    --accent-light: rgba(184, 136, 90, 0.11);
    --border:       #E4D8CC;
    --font-display: 'Nunito', system-ui, sans-serif;
    --font-sans:    'Nunito', system-ui, sans-serif;
    --max-w: 1100px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .section-label {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
    display: block;
  }

  /* ── Scroll animations — bidirectional + 3D ── */
  [data-animate] {
    opacity: 0;
    transition:
      opacity  0.72s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  /* Below viewport (default entry — slides up with 3D tilt) */
  [data-animate='slide-up']    { transform: perspective(900px) translateY(52px)  rotateX(12deg); }
  [data-animate='slide-left']  { transform: perspective(900px) translateX(56px)  rotateY(-12deg); }
  [data-animate='slide-right'] { transform: perspective(900px) translateX(-56px) rotateY(12deg); }
  [data-animate='scale-in']    { transform: perspective(900px) scale(0.82)       rotateX(10deg); }
  [data-animate='flip-up']     { transform: perspective(700px) rotateX(60deg) translateY(24px); transform-origin: bottom center; }

  /* Above viewport (re-entry from scrolling back up) */
  [data-animate='slide-up'].above    { transform: perspective(900px) translateY(-32px) rotateX(-8deg); }
  [data-animate='slide-left'].above  { transform: perspective(900px) translateY(-28px) rotateY(-4deg); }
  [data-animate='slide-right'].above { transform: perspective(900px) translateY(-28px) rotateY(4deg); }
  [data-animate='scale-in'].above    { transform: perspective(900px) scale(0.94) rotateX(-6deg); }
  [data-animate='flip-up'].above     { transform: perspective(700px) rotateX(-25deg) translateY(-16px); transform-origin: top center; }

  /* Visible */
  [data-animate].in-view {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate],
    [data-animate].above,
    [data-animate].in-view {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* ── Cozy theme: global component rules ── */
  .hero {
    background:
      linear-gradient(rgba(46,42,38,0.84) 0%, rgba(46,42,38,0.77) 40%, rgba(46,42,38,0.91) 100%),
      url('https://images.unsplash.com/photo-1775883376447-655984a514bd?auto=format&fit=crop&w=1920&q=80')
      center / cover no-repeat;
  }
  .hero-title   { font-weight: 900; letter-spacing: -0.02em; }
  .hero-eyebrow { color: #D4A87A; }
  .btn-primary  { border-radius: 50px; }
  .btn-outline  { border-radius: 50px; }

  .about-heading        { font-weight: 800; }
  .about-heading em     { font-style: italic; font-weight: 800; color: var(--accent); }
  .stat-value           { color: var(--accent); }
  .about-photo-wrap     { border-radius: 18px; }
  .about-photo          { border-radius: 17px; }
  .review-card          { border-radius: 18px; }
  .review-quote         { font-size: 3.5rem; color: var(--accent); opacity: 0.35; }

  .cat-header           { border-bottom: 2px dotted var(--border); }
  .highlight-card       { border-radius: 18px; border-color: transparent; box-shadow: 0 4px 20px rgba(46,42,38,0.08); }
  .item-card            { border-radius: 14px; border-color: transparent; box-shadow: 0 2px 8px rgba(46,42,38,0.06); }
  .item-card:hover      { box-shadow: 0 8px 28px rgba(46,42,38,0.11); transform: translateY(-3px); }
  .item-price           { color: var(--accent); }

  .tag-veg   { background: rgba(118,172,112,0.13); color: #3A7036; border-radius: 50px; }
  .tag-spicy { background: rgba(194,120,60,0.12);  color: #9A5520; border-radius: 50px; }
  .tag-hot   { background: rgba(184,136,90,0.14);  color: #7A5230; border-radius: 50px; }

  .order              { background: var(--accent); }
  .order-btn-primary  { border-radius: 50px; background: white; color: var(--accent); }
  .order-btn-outline  { border-radius: 50px; }

  .nav-cta      { border-radius: 50px !important; }
  .lang-switch  { border-radius: 50px !important; }
  .footer-logo  { color: #D4A87A; }

  /* ── Mobile: simplify 3D transforms for performance ── */
  @media (max-width: 720px) {
    [data-animate]               { transition-duration: 0.5s; }
    [data-animate='slide-up']    { transform: translateY(28px); }
    [data-animate='slide-left']  { transform: translateX(28px); }
    [data-animate='slide-right'] { transform: translateX(-28px); }
    [data-animate='scale-in']    { transform: scale(0.93); }
    [data-animate='flip-up']     { transform: translateY(28px); }
    [data-animate].above         { transform: translateY(-18px) !important; }
  }
</style>
