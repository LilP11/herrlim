---
import { translations } from '../i18n/translations.js';
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const t = translations[lang];
---

<section class="about" id="about">
  <div class="about-inner">
    <div class="about-content" data-animate="slide-right">
      <span class="section-label">{t.about.label}</span>
      <h2 class="about-heading">
        {t.about.heading1}<br /><em>{t.about.heading2}</em>
      </h2>
      <div class="about-text">
        <p set:html={t.about.p1} />
        <p>{t.about.p2}</p>
        <p>{t.about.p3}</p>
      </div>
      <div class="about-stats">
        <div class="stat" data-animate="slide-up" style="transition-delay:0s">
          <span class="stat-value">4,9</span>
          <span class="stat-label">{t.about.statRating}</span>
        </div>
        <div class="stat" data-animate="slide-up" style="transition-delay:0.12s">
          <span class="stat-value">500+</span>
          <span class="stat-label">{t.about.statReviews}</span>
        </div>
        <div class="stat" data-animate="slide-up" style="transition-delay:0.24s">
          <span class="stat-value">#1</span>
          <span class="stat-label">{t.about.statRank}</span>
        </div>
      </div>
    </div>

    <div class="about-aside" data-animate="slide-left">
      <div class="about-photo-wrap">
        <img
          src="https://images.unsplash.com/photo-1744870132190-5c02d3f8d9f9?auto=format&fit=crop&w=800&q=80"
          alt="Koreanisches Street Food – Tteokbokki, Kimchi und K-Chicken auf Holztisch"
          class="about-photo"
          loading="lazy"
          width="800"
          height="534"
        />
      </div>
      <div class="review-card">
        <div class="review-quote">"</div>
        <blockquote class="review-text">{t.about.review1}</blockquote>
        <cite class="review-cite">{t.about.reviewSource}</cite>
      </div>
      <div class="review-card">
        <div class="review-quote">"</div>
        <blockquote class="review-text">{t.about.review2}</blockquote>
        <cite class="review-cite">{t.about.reviewSource}</cite>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 1.5rem;
    background: var(--bg);
  }

  .about-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
    position: relative;
  }

  /* Floating chicken bowl decoration */
  .about-content::before {
    content: '';
    position: absolute;
    top: -3rem;
    right: -2rem;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background:
      url('https://images.unsplash.com/photo-1624153064067-566cae78993d?auto=format&fit=crop&w=240&q=80')
      center / cover;
    box-shadow: 0 12px 36px rgba(0,0,0,0.18);
    animation: deco-float 7s ease-in-out infinite;
    opacity: 0;
    transition: opacity 0.6s ease 0.4s;
    pointer-events: none;
  }

  /* Show decoration once parent is animated in */
  .about-content.in-view::before {
    opacity: 1;
  }

  @keyframes deco-float {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50%       { transform: translateY(-12px) rotate(4deg); }
  }

  @media (max-width: 800px) {
    .about-content::before { display: none; }
  }

  .about-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .about-heading em {
    color: var(--accent);
    font-style: italic;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .about-text p {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.8;
  }

  .about-stats {
    display: flex;
    gap: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 3.5rem;
  }

  .about-photo-wrap {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .about-photo {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
  }

  .review-card {
    background: var(--bg-alt);
    border-radius: 8px;
    padding: 2rem 2rem 1.75rem;
    border: 1px solid var(--border);
  }

  .review-quote {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 0.4;
    color: var(--accent);
    opacity: 0.25;
    margin-bottom: 1.25rem;
    display: block;
  }

  .review-text {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text);
    font-style: italic;
    margin-bottom: 1rem;
  }

  .review-cite {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-style: normal;
  }

  @media (max-width: 800px) {
    .about {
      padding: 4rem 1.2rem;
    }

    .about-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about-aside {
      padding-top: 0;
    }
  }

  @media (max-width: 480px) {
    .about-stats {
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .stat-value {
      font-size: 1.75rem;
    }
  }
</style>
