<div class="cube-wrap" aria-hidden="true">
  <div class="cube-scene">
    <div class="cube">
      <div class="face face-front">
        <img src="/images/logo.jpg" alt="" />
      </div>
      <div class="face face-back">
        <img src="/images/logo.jpg" alt="" />
      </div>
      <div class="face face-left">
        <img src="/images/logo.jpg" alt="" />
      </div>
      <div class="face face-right">
        <img src="/images/logo.jpg" alt="" />
      </div>
      <div class="face face-top">
        <img src="/images/logo.jpg" alt="" />
      </div>
      <div class="face face-bottom">
        <img src="/images/logo.jpg" alt="" />
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Outer wrapper: positions in hero, slide-in on load ── */
  .cube-wrap {
    position: absolute;
    right: 7%;
    top: 50%;
    transform: translateY(-50%);
    display: none;
    pointer-events: none;
    animation: cube-enter 1.4s cubic-bezier(0.34, 1.05, 0.64, 1) 1s both;
  }

  @media (min-width: 960px) { .cube-wrap { display: block; } }

  @keyframes cube-enter {
    from { opacity: 0; transform: translateY(-50%) translateX(70px) scale(0.82); }
    to   { opacity: 1; transform: translateY(-50%) translateX(0)    scale(1); }
  }

  /* ── Scene: holds perspective + drives the Y rotation ── */
  .cube-scene {
    width: 220px;
    height: 220px;
    perspective: 750px;
    perspective-origin: 50% 42%;
    animation: spin-y 28s linear infinite;
  }

  @keyframes spin-y {
    from { transform: rotateY(0deg); }
    to   { transform: rotateY(360deg); }
  }

  /* ── Cube: the X tilt + subtle Z roll live here ──
     Two animations at different periods so the motion
     never feels mechanical or repetitive.              */
  .cube {
    width: 220px;
    height: 220px;
    position: relative;
    transform-style: preserve-3d;
    animation:
      tilt-x 12s ease-in-out infinite,
      roll-z 17s ease-in-out infinite;
  }

  @keyframes tilt-x {
    0%, 100% { transform: rotateX(-12deg); }
    50%       { transform: rotateX(-36deg); }
  }

  @keyframes roll-z {
    0%, 100% { transform: rotateZ(-3deg); }
    50%       { transform: rotateZ( 3deg); }
  }

  /* ── Faces ── */
  .face {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 18px;
    overflow: hidden;
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    backface-visibility: visible;
  }

  /* Soft directional sheen so each face looks lit differently */
  .face::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      130deg,
      rgba(255, 255, 255, 0.09) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.12) 100%
    );
    pointer-events: none;
  }

  .face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* translateZ = half the cube size (220 / 2 = 110) */
  .face-front  { transform: translateZ(110px); }
  .face-back   { transform: rotateY(180deg) translateZ(110px); }
  .face-left   { transform: rotateY(-90deg) translateZ(110px); }
  .face-right  { transform: rotateY( 90deg) translateZ(110px); }
  .face-top    { transform: rotateX( 90deg) translateZ(110px); }
  .face-bottom { transform: rotateX(-90deg) translateZ(110px); }

  @media (prefers-reduced-motion: reduce) {
    .cube-scene, .cube { animation: none; }
    .cube { transform: rotateX(-20deg) rotateY(25deg); }
  }
</style>
