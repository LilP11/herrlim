---

<div class="logo-wrap">
  <img
    src="/images/logo.jpg"
    alt="Herr Lim"
    class="logo-card"
    id="hero-logo-card"
    draggable="false"
  />
</div>

<script>
  const card = document.getElementById('hero-logo-card') as HTMLElement;
  if (!card) throw new Error('logo card not found');

  let isHovered = false;

  card.addEventListener('mouseenter', () => {
    isHovered = true;
    card.style.transition = 'none';
  });

  card.addEventListener('mousemove', e => {
    if (!isHovered) return;
    const r  = card.getBoundingClientRect();
    const x  = (e.clientX - r.left)  / r.width  - 0.5; // -0.5 … 0.5
    const y  = (e.clientY - r.top)   / r.height - 0.5;

    card.style.transform =
      `perspective(600px) rotateY(${x * 24}deg) rotateX(${-y * 18}deg) scale(1.08)`;

    // Shadow shifts opposite to tilt — enhances the 3-D illusion
    const sx = -x * 22;
    const sy = -y * 16;
    card.style.boxShadow =
      `${sx}px ${sy}px 50px rgba(0,0,0,0.38), 0 8px 24px rgba(0,0,0,0.25)`;
  });

  card.addEventListener('mouseleave', () => {
    isHovered = false;
    card.style.transition =
      'transform 0.65s cubic-bezier(0.23,1,0.32,1), box-shadow 0.65s cubic-bezier(0.23,1,0.32,1)';
    card.style.transform  = '';
    card.style.boxShadow  = '';
  });
</script>

<style>
  .logo-wrap {
    position: absolute;
    right: 7%;
    top: 50%;
    transform: translateY(-50%);
    display: none;
    pointer-events: none; /* only the img intercepts events */
    animation: logo-enter 1.3s cubic-bezier(0.34, 1.05, 0.64, 1) 0.9s both;
  }

  @media (min-width: 960px) { .logo-wrap { display: block; } }

  @keyframes logo-enter {
    from { opacity: 0; transform: translateY(-50%) translateX(60px); }
    to   { opacity: 1; transform: translateY(-50%) translateX(0);    }
  }

  .logo-card {
    display: block;
    width: 230px;
    height: 230px;
    border-radius: 22px;
    object-fit: cover;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    transition:
      transform  0.65s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.65s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, box-shadow;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-card { transition: none; }
  }
</style>
