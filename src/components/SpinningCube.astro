---
// 6-face cube: logo + 5 food photos
---

<div class="cube-wrap" aria-hidden="true">
  <div class="cube-scene">
    <div class="cube">

      <div class="face face-front">
        <img src="/images/logo.jpg" alt="" loading="eager" />
      </div>

      <div class="face face-back">
        <img
          src="https://images.unsplash.com/photo-1744870132190-5c02d3f8d9f9?auto=format&fit=crop&w=440&q=75"
          alt="" loading="lazy"
        />
      </div>

      <div class="face face-left">
        <img
          src="https://images.unsplash.com/photo-1741295017668-c8132acd6fc0?auto=format&fit=crop&w=440&q=75"
          alt="" loading="lazy"
        />
      </div>

      <div class="face face-right">
        <img
          src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=440&q=75"
          alt="" loading="lazy"
        />
      </div>

      <div class="face face-top">
        <img
          src="https://images.unsplash.com/photo-1624153064067-566cae78993d?auto=format&fit=crop&w=440&q=75"
          alt="" loading="lazy"
        />
      </div>

      <div class="face face-bottom">
        <img
          src="https://images.unsplash.com/photo-1775883376447-655984a514bd?auto=format&fit=crop&w=440&q=75"
          alt="" loading="lazy"
        />
      </div>

    </div>
  </div>
  <div class="cube-shadow"></div>
</div>

<style>
  /* ── Outer wrapper: positions in hero, handles enter slide-in ── */
  .cube-wrap {
    position: absolute;
    right: 7%;
    top: 50%;
    display: none;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    animation: cube-enter 1.1s cubic-bezier(0.34, 1.2, 0.64, 1) 0.9s both;
  }

  @media (min-width: 960px) {
    .cube-wrap { display: flex; }
  }

  @keyframes cube-enter {
    from { opacity: 0; transform: translateY(-50%) translateX(120px) scale(0.75); }
    to   { opacity: 1; transform: translateY(-50%) translateX(0)     scale(1); }
  }

  /* ── Scene: perspective + vertical bob ── */
  .cube-scene {
    width: 220px;
    height: 220px;
    perspective: 900px;
    perspective-origin: 50% 40%;
    animation: cube-bob 5s ease-in-out 2s infinite;
  }

  @keyframes cube-bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-16px); }
  }

  /* ── Cube: continuous Y rotation with slight X tilt ── */
  .cube {
    width: 220px;
    height: 220px;
    position: relative;
    transform-style: preserve-3d;
    animation: cube-spin 16s linear 2s infinite;
    transition: animation-duration 0.4s;
  }

  @keyframes cube-spin {
    from { transform: rotateX(-22deg) rotateY(0deg); }
    to   { transform: rotateX(-22deg) rotateY(360deg); }
  }

  /* Speed up on hover */
  .cube-scene:hover .cube {
    animation-duration: 3.5s;
  }

  /* ── Faces ── */
  .face {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.14);
    backface-visibility: visible;
  }

  /* Glass sheen overlay on each face */
  .face::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.12) 0%,
      transparent 45%,
      rgba(0, 0, 0, 0.18) 100%
    );
    pointer-events: none;
  }

  .face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Half of 220px = 110px */
  .face-front  { transform: translateZ(110px); }
  .face-back   { transform: rotateY(180deg) translateZ(110px); }
  .face-left   { transform: rotateY(-90deg) translateZ(110px); }
  .face-right  { transform: rotateY(90deg)  translateZ(110px); }
  .face-top    { transform: rotateX(90deg)  translateZ(110px); }
  .face-bottom { transform: rotateX(-90deg) translateZ(110px); }

  /* ── Floating shadow ── */
  .cube-shadow {
    width: 180px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.45) 0%, transparent 68%);
    margin-top: 18px;
    animation: shadow-pulse 5s ease-in-out 2s infinite;
  }

  @keyframes shadow-pulse {
    0%, 100% { transform: scaleX(1);    opacity: 0.55; }
    50%       { transform: scaleX(0.75); opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cube-wrap, .cube-scene, .cube, .cube-shadow {
      animation: none !important;
    }
    .cube-wrap {
      opacity: 1;
      transform: translateY(-50%);
    }
  }
</style>
