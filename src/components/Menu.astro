---
import { translations } from '../i18n/translations.js';
import { menuCategories } from '../data/menu.js';
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const t = translations[lang];

function formatPrice(price: number): string {
  return `€ ${price.toFixed(2).replace('.', ',')}`;
}

const tagClass: Record<string, string> = {
  vegetarisch: 'tag-veg',
  scharf: 'tag-spicy',
  'sehr scharf': 'tag-hot',
};
---

<section class="menu" id="menu">
  <div class="menu-inner">
    <div class="menu-header" data-animate="slide-up">
      <span class="section-label">{t.menu.label}</span>
      <h2 class="menu-title">{t.menu.title}</h2>
      <p class="menu-subtitle">{t.menu.subtitle}</p>
    </div>

    <div class="highlights">
      <a href="#cat-bibimbap" class="highlight-card" data-animate="slide-up" data-tilt style="transition-delay:0s" aria-label="Bibimbap – zur Speisekarte">
        <img
          src="https://images.unsplash.com/photo-1741295017668-c8132acd6fc0?auto=format&fit=crop&w=600&q=80"
          alt="Bibimbap"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="highlight-label">
          <span class="hl-korean">비빔밥</span>
          <span class="hl-name">Bibimbap</span>
        </div>
        <div class="highlight-arrow">↓</div>
      </a>
      <a href="#cat-ramen" class="highlight-card" data-animate="slide-up" data-tilt style="transition-delay:0.1s" aria-label="Ramen – zur Speisekarte">
        <img
          src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=600&q=80"
          alt="Ramen"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="highlight-label">
          <span class="hl-korean">라면</span>
          <span class="hl-name">Ramen</span>
        </div>
        <div class="highlight-arrow">↓</div>
      </a>
      <a href="#cat-chicken" class="highlight-card" data-animate="slide-up" data-tilt style="transition-delay:0.2s" aria-label="K-Chicken – zur Speisekarte">
        <img
          src="https://images.unsplash.com/photo-1624153064067-566cae78993d?auto=format&fit=crop&w=600&q=80"
          alt="K-Chicken"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="highlight-label">
          <span class="hl-korean">닭강정</span>
          <span class="hl-name">K-Chicken</span>
        </div>
        <div class="highlight-arrow">↓</div>
      </a>
      <a href="#cat-tteokbokki" class="highlight-card highlight-more" data-animate="slide-up" data-tilt style="transition-delay:0.3s" aria-label="Und vieles mehr – zur Speisekarte">
        <img
          src="https://images.unsplash.com/photo-1744870132190-5c02d3f8d9f9?auto=format&fit=crop&w=600&q=80"
          alt="Und vieles mehr"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="highlight-label">
          <span class="hl-korean">그리고 더</span>
          <span class="hl-name">Und vieles mehr</span>
        </div>
        <div class="highlight-arrow">↓</div>
      </a>
    </div>

    {menuCategories.map((cat, ci) => (
      <div class="category" id={`cat-${cat.id}`} data-animate="slide-up" style={`transition-delay:${ci * 0.07}s`}>
        <div class="cat-header">
          <div class="cat-names">
            <h3 class="cat-name">{typeof cat.name === 'object' ? cat.name[lang] : cat.name}</h3>
            <span class="cat-korean">{cat.korean}</span>
          </div>
          <div class="cat-meta">
            <span class="cat-subtitle">{cat.subtitle[lang]}</span>
            {cat.description && <span class="cat-desc">{cat.description[lang]}</span>}
          </div>
        </div>

        <div class="items-grid">
          {cat.items.map((item, ii) => (
            <div class="item-card" data-animate="scale-in" data-tilt style={`transition-delay:${ii * 0.06}s`}>
              <div class="item-top">
                <span class="item-code">{item.code}</span>
                <span class="item-price">{formatPrice(item.price)}</span>
              </div>
              <h4 class="item-name">{item.name}</h4>
              {item.description && <p class="item-desc">{item.description[lang]}</p>}
              {item.tags && item.tags.length > 0 && (
                <div class="item-tags">
                  {item.tags.map((tag) => (
                    <span class={`tag ${tagClass[tag] ?? ''}`}>{t.tags[tag] ?? tag}</span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}

    <p class="menu-disclaimer">{t.menu.disclaimer}</p>
  </div>
</section>

<style>
  .menu {
    background: var(--bg-alt);
    padding: 6rem 1.5rem;
  }

  .menu-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .menu-header {
    margin-bottom: 4rem;
  }

  .menu-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .menu-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .highlight-card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--border);
    display: block;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(46, 42, 38, 0.18);
  }

  .highlight-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .highlight-card:hover img {
    transform: scale(1.06);
  }

  .highlight-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1rem 1rem;
    background: linear-gradient(transparent, rgba(28, 24, 20, 0.88));
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hl-korean {
    font-size: 0.7rem;
    color: rgba(250, 247, 242, 0.5);
    letter-spacing: 0.12em;
  }

  .hl-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: #faf7f2;
    line-height: 1.2;
  }

  .highlight-arrow {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: white;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.2s, transform 0.2s;
  }

  .highlight-card:hover .highlight-arrow {
    opacity: 1;
    transform: scale(1);
  }

  /* "Und vieles mehr" card — warm tinted overlay */
  .highlight-more .highlight-label {
    background: linear-gradient(transparent, rgba(46, 30, 18, 0.92));
  }

  .highlight-more .hl-name {
    font-size: 1rem;
  }

  .category {
    margin-bottom: 3.5rem;
  }

  .cat-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .cat-names {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cat-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text);
    line-height: 1;
  }

  .cat-korean {
    font-size: 1rem;
    color: var(--accent);
    opacity: 0.6;
  }

  .cat-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    text-align: right;
  }

  .cat-subtitle {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cat-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
  }

  .item-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .item-card:hover {
    border-color: rgba(192, 57, 43, 0.3);
    box-shadow: 0 2px 12px rgba(192, 57, 43, 0.06);
  }

  .item-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .item-code {
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .item-price {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .item-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .item-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .tag {
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font-weight: 500;
  }

  .tag-veg {
    background: rgba(34, 120, 60, 0.1);
    color: #1a6632;
  }

  .tag-spicy {
    background: rgba(220, 100, 30, 0.1);
    color: #b84a12;
  }

  .tag-hot {
    background: rgba(192, 57, 43, 0.12);
    color: var(--accent);
  }

  .menu-disclaimer {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .items-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .highlights {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .menu {
      padding: 4rem 1.2rem;
    }

    .menu-header {
      margin-bottom: 2.5rem;
    }

    .highlights {
      margin-bottom: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .highlights {
      grid-template-columns: repeat(2, 1fr);
    }

    .items-grid {
      grid-template-columns: 1fr;
    }

    .cat-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .cat-meta {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
