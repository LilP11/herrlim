---
import { translations } from '../i18n/translations.js';
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const t = translations[lang];
---

<section class="location" id="location">
  <div class="location-inner">
    <div class="location-info">
      <span class="section-label" style="color: rgba(250,247,242,0.5)">{t.location.label}</span>
      <h2 class="location-title">{t.location.title}</h2>

      <address class="address">
        <div class="address-line">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5C5.51 1.5 3.5 3.51 3.5 6c0 3.5 4.5 8.5 4.5 8.5s4.5-5 4.5-8.5c0-2.49-2.01-4.5-4.5-4.5zm0 6a1.5 1.5 0 110-3 1.5 1.5 0 010 3z" fill="currentColor"/>
          </svg>
          <span>Haingasse 17<br />61348 Bad Homburg vor der Höhe</span>
        </div>
        <div class="address-line">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.5 2h2l1 2.5-1.5 1.5a8 8 0 004 4l1.5-1.5L13 9.5v2A1.5 1.5 0 0111.5 13C6.25 13 2 8.75 2 3.5A1.5 1.5 0 013.5 2z" fill="currentColor"/>
          </svg>
          <a href="tel:+4915563304547">+49 155 63 304547</a>
        </div>
      </address>

      <div class="hours-table">
        <h3 class="hours-title">{t.location.hoursTitle}</h3>
        <dl class="hours-list">
          <div class="hours-row">
            <dt>{t.location.monFri}</dt>
            <dd>11:30 – 15:00<br />16:30 – 19:00</dd>
          </div>
          <div class="hours-row hours-closed">
            <dt>{t.location.sat}</dt>
            <dd>{t.location.closed}</dd>
          </div>
          <div class="hours-row hours-closed">
            <dt>{t.location.sun}</dt>
            <dd>{t.location.closed}</dd>
          </div>
        </dl>
      </div>

      <p class="location-note">{t.location.note}</p>
    </div>

    <div class="location-map">
      <iframe
        src="https://maps.google.com/maps?q=Haingasse+17,+61348+Bad+Homburg+vor+der+H%C3%B6he&hl=de&z=17&output=embed"
        title="Herr Lim auf Google Maps"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        aria-label="Karte: Herr Lim, Haingasse 17, Bad Homburg"
      ></iframe>
      <a
        href="https://maps.google.com/maps?q=Haingasse+17,+61348+Bad+Homburg+vor+der+H%C3%B6he"
        target="_blank"
        rel="noopener noreferrer"
        class="map-link"
      >
        {t.location.mapsLink}
      </a>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--bg-dark);
    color: white;
    padding: 6rem 1.5rem;
  }

  .location-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    align-items: start;
  }

  .location-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: #faf7f2;
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
  }

  .address-line {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: rgba(250, 247, 242, 0.7);
    line-height: 1.5;
  }

  .address-line svg {
    margin-top: 2px;
    flex-shrink: 0;
    color: var(--accent);
    opacity: 0.8;
  }

  .address-line a {
    color: inherit;
    transition: color 0.2s;
  }

  .address-line a:hover {
    color: #faf7f2;
  }

  .hours-table {
    margin-bottom: 2rem;
  }

  .hours-title {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.7;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(250, 247, 242, 0.08);
    border-radius: 6px;
    overflow: hidden;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(250, 247, 242, 0.06);
    gap: 1rem;
  }

  .hours-row:last-child {
    border-bottom: none;
  }

  .hours-row dt {
    font-size: 0.875rem;
    color: rgba(250, 247, 242, 0.6);
  }

  .hours-row dd {
    font-size: 0.875rem;
    color: rgba(250, 247, 242, 0.85);
    text-align: right;
    line-height: 1.4;
  }

  .hours-closed dt,
  .hours-closed dd {
    color: rgba(250, 247, 242, 0.3);
  }

  .location-note {
    font-size: 0.8rem;
    color: rgba(250, 247, 242, 0.35);
    font-style: italic;
  }

  .location-map {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .location-map iframe {
    width: 100%;
    height: 420px;
    border: 0;
    border-radius: 8px;
    display: block;
    filter: grayscale(20%) contrast(1.05);
  }

  .map-link {
    font-size: 0.8rem;
    color: rgba(250, 247, 242, 0.4);
    transition: color 0.2s;
    align-self: flex-end;
  }

  .map-link:hover {
    color: rgba(250, 247, 242, 0.7);
  }

  @media (max-width: 800px) {
    .location {
      padding: 4rem 1.2rem;
    }

    .location-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .location-map iframe {
      height: 280px;
    }
  }
</style>
